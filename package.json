{
  "name": "rl-studio",
  "version": "0.1.0",
  "description": "RL Studio — desktop app for designing and running reinforcement learning experiments at home (Gymnasium, tabular/DQN/PPO, AlphaZero self-play)",
  "author": {
    "name": "RL Studio",
    "email": "team@rlstudio.local"
  },
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --publish never",
    "build:linux": "vite build && electron-builder --linux --publish never",
    "build:win": "vite build && electron-builder --win --publish never",
    "build:mac": "vite build && electron-builder --mac --publish never",
    "build:all": "vite build && electron-builder -mwl --publish never",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.75.0",
    "@xyflow/react": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "dockerode": "^4.0.0",
    "i18next": "^25.0.0",
    "lucide-react": "^0.500.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dockerode": "^3.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.rlstudio.app",
    "productName": "RL Studio",
    "copyright": "Copyright (c) 2026 RL Studio",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!*.pyc"
        ]
      },
      {
        "from": "rl_core",
        "to": "rl_core",
        "filter": [
          "**/*",
          "!__pycache__/**",
          "!*.pyc",
          "!.runs/**",
          "!checkpoints/**"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/dockerode/**"
    ],
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Development",
      "icon": "build/icons",
      "synopsis": "Design and run reinforcement learning experiments",
      "description": "Desktop studio for reinforcement learning: Gymnasium environments, DQN/PPO/A2C, and AlphaZero self-play, with visual experiment design.",
      "maintainer": "team@rlstudio.local",
      "desktop": {
        "entry": {
          "Name": "RL Studio",
          "Comment": "Design and run RL experiments at home",
          "Keywords": "AI;ML;RL;reinforcement-learning;alphazero;gymnasium;"
        }
      }
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RL Studio"
    }
  }
}
