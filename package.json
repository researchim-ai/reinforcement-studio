{
  "name": "reinforcement-studio",
  "version": "0.1.0",
  "description": "Reinforcement Studio — desktop app for designing and running reinforcement learning experiments at home (Gymnasium, tabular/DQN/PPO, AlphaZero self-play)",
  "author": {
    "name": "researchim-ai",
    "url": "https://github.com/researchim-ai"
  },
  "homepage": "https://github.com/researchim-ai/reinforcement-studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/researchim-ai/reinforcement-studio.git"
  },
  "bugs": {
    "url": "https://github.com/researchim-ai/reinforcement-studio/issues"
  },
  "license": "Apache-2.0",
  "private": true,
  "main": "dist-electron/main.js",
  "desktopName": "reinforcement-studio",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder --publish never",
    "build:linux": "vite build && electron-builder --linux --publish never",
    "build:win": "vite build && electron-builder --win --publish never",
    "build:mac": "vite build && electron-builder --mac --publish never",
    "build:all": "vite build && electron-builder -mwl --publish never",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.75.0",
    "@xyflow/react": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "dockerode": "^4.0.0",
    "i18next": "^25.0.0",
    "lucide-react": "^0.500.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.2.0",
    "three": "^0.175.0",
    "@react-three/fiber": "^9.1.2",
    "@react-three/drei": "^10.0.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/three": "^0.175.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dockerode": "^3.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^3.2.7"
  }
}
